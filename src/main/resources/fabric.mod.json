  "mixins": [
    {
      "config": "hookshot.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "~1.19.2",
    "java": ">=17"
  }
